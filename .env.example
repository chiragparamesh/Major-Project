# MLBFD - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mlbfd_db
DB_USER=mlbfd_user
DB_PASS=
DATABASE_URL=sqlite:///mlbfd.sqlite3

# Security (Minimum 32 characters required)
MLBFD_SECRET_KEY=CHANGE_ME_run_scripts_rotate_secrets_py_64_hex_chars
JWT_SECRET_KEY=CHANGE_ME_run_scripts_rotate_secrets_py_64_hex_chars

# Multi-Factor OTP & Notification Services (Free Tier / Mock)
# Email OTP (Free SMTP, e.g. Gmail App Password or Brevo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Relay login if it differs from EMAIL_USER (Brevo: xxxx@smtp-brevo.com); leave empty for Gmail
EMAIL_SMTP_LOGIN=
EMAIL_USER=your.address@gmail.com
EMAIL_PASSWORD=YOUR_16_LETTER_GMAIL_APP_PASSWORD_NO_SPACES
EMAIL_FROM_NAME=MLBFD
EMAIL_FROM=your.address@gmail.com
EMAIL_DRY_RUN=false
# Legacy SMTP_* aliases (read only if the EMAIL_* name is empty; leave blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram Bot OTP (Free BotFather API: @BotFather)
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
TELEGRAM_BOT_USERNAME=mlbfd_otp_bot
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_DRY_RUN=false

# API Keys (set to MOCK for default local testing)
GOOGLE_SAFE_BROWSING_API_KEY=MOCK
FIREBASE_SERVER_KEY=MOCK
# Firebase service-account JSON (kept outside git, e.g. secrets/firebase-service-account.json)
FIREBASE_CREDENTIALS_FILE=
OPENPHISH_API_KEY=MOCK

# App Configuration
FLASK_ENV=development
FLASK_PORT=5000
VIRTUAL_BALANCE=100000.0
MAX_PAYLOAD_KB=10
RATE_LIMIT_PER_MIN=30
OTP_EXPIRY_SECONDS=300
SESSION_TIMEOUT_MINUTES=15
TRUSTED_PAYEE_MIN_TXNS=3
SCAM_LIST_REFRESH_HOURS=6
REDUCED_TXN_LIMIT=10000.0
REDUCED_DAILY_LIMIT=25000.0

# Added 2026-10-31 (see OTP_SETUP.md)
EMAIL_SMTP_MODE=auto
# Request-signing key compiled into the Flutter app (public by nature; NOT MLBFD_SECRET_KEY)
MLBFD_CLIENT_SECRET=
# Enables GET /api/health/otp remotely (header X-Admin-Token)
ADMIN_API_TOKEN=
HASH_PEPPER=CHANGE_ME_run_scripts_rotate_secrets_py
